[Unit]
Description=Shopping Tools discovery run (%i)
After=network-online.target

[Service]
Type=oneshot
User=elliot
WorkingDirectory=/home/elliot/apps/shopping-tools
EnvironmentFile=/home/elliot/var/lib/shopping-tools/discovery.env
ExecStart=/usr/bin/timeout --signal=TERM 5m /usr/bin/python3 discovery_run.py --search-id %i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
