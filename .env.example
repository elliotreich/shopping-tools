# Shopping Tools backend — configuration template.
# Copy to `.env` (same directory as server.py). `.env` is git-ignored —
# never commit it. All variables are optional; defaults are shown.

# ── Server ──────────────────────────────────────────────────────────────────
# Bind address and HTTP port. Default 0.0.0.0:8091 so the Mac apps can reach
# the VPS.
# SHOPPING_TOOLS_HOST=0.0.0.0
# SHOPPING_TOOLS_PORT=8091

# ── Search ──────────────────────────────────────────────────────────────────
# Local SearXNG JSON endpoint used by /api/search.
# SHOPPING_TOOLS_SEARXNG_URL=http://127.0.0.1:8888/search
# Per-retailer request timeout in seconds.
# SHOPPING_TOOLS_SEARCH_TIMEOUT=10
# Max results returned per retailer.
# SHOPPING_TOOLS_MAX_RESULTS_PER_RETAILER=20

# ── Menswear Watcher data (read-only) ───────────────────────────────────────
# Path of the Menswear Watcher SQLite store opened by /api/resale and
# /api/resale/summary. The backend opens it read-only (mode=ro + query_only)
# and never modifies it. Override if your copy of seen.db lives elsewhere,
# e.g. the syncthing-shared checkout on this VPS:
# SHOPPING_TOOLS_DB_PATH=/home/elliot/syncthing-shared/1_projects/Menswear Watcher/seen.db

# ── Discovery review API ────────────────────────────────────────────────────
# Required for /api/discovery/*; keep this in a service EnvironmentFile, not Git.
# DISCOVERY_API_TOKEN=generate-a-long-random-token-outside-git
# DISCOVERY_DB_PATH=/home/elliot/var/lib/shopping-tools/discovery.sqlite3
# DISCOVERY_LOCK_PATH=/home/elliot/var/lock/shopping-tools-discovery.lock
# DISCOVERY_LOG_DIR=/home/elliot/var/log/shopping-tools-discovery
# JOB_AGENTS_DIR="/home/elliot/syncthing-shared/2_areas/Digital Systems/job-agents"
