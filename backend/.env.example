# Shopping Tools backend — configuration template.
# Copy to `.env` (same directory as server.py). `.env` is git-ignored —
# never commit it. All variables are optional; defaults are shown.

# ── Server ──────────────────────────────────────────────────────────────────
# Bind address and HTTP port. Default 0.0.0.0:8091 for a local or self-hosted
# deployment.
# SHOPPING_TOOLS_HOST=0.0.0.0
# SHOPPING_TOOLS_PORT=8091

# ── Resale feed data (read-only) ────────────────────────────────────────────
# Path of the resale-feed SQLite store opened by /api/resale and
# /api/resale/summary. The backend opens it read-only (mode=ro + query_only)
# and never modifies it. Override if your copy of seen.db lives elsewhere,
# or leave the default at data/resale.sqlite3:
# SHOPPING_TOOLS_DB_PATH=/path/to/resale.sqlite3
